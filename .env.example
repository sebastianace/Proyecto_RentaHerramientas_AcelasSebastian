# Copia este archivo como .env y pon tus valores reales.
# .env está en .gitignore: NUNCA lo subas a GitHub.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/renta_herramientas?serverTimezone=America/Bogota&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=renta_app
DB_PASSWORD=cambia_esta_clave

MEDIA_BASE_PATH=./uploads

# Clave para firmar los JWT: Base64 de al menos 32 bytes aleatorios (ver README)
JWT_SECRET=genera_tu_propia_clave_base64
JWT_EXPIRACION=60m

# Orígenes del frontend permitidos por CORS (Live Server usa el puerto 5500)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
